# ─── Supabase ───────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to client

# ─── Paystack ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx   # safe for client
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx               # server-side ONLY
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret            # from Paystack dashboard

# ── FAFOTECH (Priority #1 — cheapest Nigerian VTU provider)
# Register at: https://fafotech.com/signup/
# Get API key from: Dashboard → Developer's API after registration
FAFOTECH_API_KEY=your-fafotech-api-key
FAFOTECH_BASE_URL=https://fafotech.com/api
FAFOTECH_USERNAME=your-fafotech-username

# ─── VTU Provider (VTU.ng) ────────────────────────────────────────────────
# Get from: https://vtu.ng → API Documentation
VTU_API_KEY=your-vtu-ng-api-key
VTU_BASE_URL=https://api.vtu.ng/v1
VTU_USERNAME=your-vtu-ng-username

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VaultPay

# ─── PostHog Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Upstash Redis & Rate Limiting ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=your_sentry_auth_token
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@sentry.io/xxxxxx
